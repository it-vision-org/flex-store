{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "RESEND_API_KEY",
    "UPLOADTHING_TOKEN",
    "UPLOADTHING_APP_ID",
    "UPLOADTHING_REGIONS",
    "JWT_SECRET",
    "CONTACT_RECIPIENT",
    "NEXT_PUBLIC_APP_URL",
    "META_TOKEN_ENCRYPTION_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
